# Контекст сборки отправляется демону Docker целиком, поэтому всё лишнее
# здесь — это лишние секунды и мегабайты на каждой сборке. В data/photos
# лежит около 400 МБ картинок, в .venv — ещё больше.
#
# Что нужно образу, перечислено в Dockerfile через COPY: kz/, зависимости
# и три файла routed-модели. Всё остальное можно смело исключать.

.venv/
.git/
.github/
__pycache__/
*.pyc
*.pyo

# данные и логи: в образе им делать нечего
data/*
!data/models/
data/models/*
!data/models/price_model.cbm
!data/models/price_cheap_specialist.cbm
!data/models/price_model.metadata.json
logs/
debug/

# инструменты разработки и портфолио — не рантайм
tests/
docs/
airflow/
sql/
notebooks/

.env
*.md
