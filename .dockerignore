# Docker sends the entire build context to the daemon. Excluding the local
# environment, photos, and source data keeps every build smaller and safer.
#
# Dockerfile lists the runtime inputs explicitly: kz/, web dependencies, and
# the three routed-model files under deploy/models/.

.venv/
.git/
.github/
__pycache__/
*.pyc
*.pyo

# Source data and operational logs never belong in the public image.
data/
logs/
debug/

# Development and portfolio material is not required at runtime.
tests/
docs/
airflow/
sql/
notebooks/

.env
*.md
