__pycache__/
*.pyc
.venv/
.env
.DS_Store
.pytest_cache/
# CatBoost training logs are generated artifacts, not source code.
catboost_info/
browser_state.json
cache/

# Runtime data is not source code; .gitkeep preserves the directory layout.
data/**/*.csv
data/**/*.png
data/**/*.bak
logs/*.log
# Runtime state, including the rolling request-budget journal.
logs/*.json
logs/*.lock

# Marketplace HTML debug dumps are large, generated, and not source code.
debug/*.html

# Generated reports are local artifacts.
data/**/*.html
# COCO exports contain derived manual labels and local paths; keep them private.
data/eda/*.coco.json
# The bootstrap audit contains metrics derived from the current private data.
data/eda/mape_stability.json
# Local training artifacts remain ignored. The explicitly reviewed copies under
# deploy/models/ are the only models published for the read-only demo.
data/models/*.cbm
data/models/*.json
# Image-derived features are private derivatives of third-party content.
data/models/*.npz

# Generated local-tool working directories.
output/
tmp/
cache/
browser_state.json
data/photos/
.coverage
.ci-smoke/
