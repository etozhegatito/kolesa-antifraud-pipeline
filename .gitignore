__pycache__/
*.pyc
.venv/
.env
.DS_Store
.pytest_cache/
# CatBoost пишет сюда логи обучения (train_price_model.py) — артефакт, не код
catboost_info/
browser_state.json
cache/

# runtime-данные — не код; структура папок сохранена через .gitkeep
data/**/*.csv
data/**/*.png
data/**/*.bak
logs/*.log
# runtime-состояние (напр. .catch_up_budget.json — суточный счётчик бюджета)
logs/*.json
logs/*.lock

# debug-дампы страниц kolesa — не код, раздувают репо и языковую
# статистику GitHub (532КБ HTML). Регенерируются debug/debug_selectors.py.
debug/*.html

# сгенерированные HTML-отчёты (ml_report.py) — артефакт
data/**/*.html
# COCO-export содержит производную ручной фото-разметки и локальные пути;
# это пересобираемый приватный артефакт, а не публичный код.
data/eda/*.coco.json
# обученные модели и их metadata содержат fingerprint локального датасета;
# воспроизводятся командами train_price_model.py / residual_detector.py
data/models/*.cbm
data/models/*.json
# признаки из фотографий: производные от чужого контента,
# пересчитываются kz.ml.photo_features и kz.ml.photo_clip
data/models/*.npz

# рабочие каталоги локальных инструментов (генерируются, не код проекта)
output/
tmp/
cache/
browser_state.json
data/photos/
.coverage
